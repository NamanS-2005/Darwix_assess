# Copy to .env and fill in. Never commit .env.

# --- LLM / ASR providers (OpenAI-compatible endpoints) ---
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional extra keys (free tiers have per-model daily token limits; each key/provider adds its own quota to the
# automatic fallback chain). Second keys reuse the same model lists.
GROQ_API_KEY_2=
GEMINI_API_KEY_2=
# Other OpenAI-compatible providers: set the key AND a comma-separated model list (fallback order)
CEREBRAS_API_KEY=
CEREBRAS_MODELS=
OPENROUTER_API_KEY=
OPENROUTER_MODELS=
OPENAI_API_KEY=
OPENAI_MODELS=

# Primary provider for chat: groq | gemini (the other is used as automatic fallback)
LLM_PRIMARY=groq
# Model chains are comma-separated (fallback order) – see common/config.py for defaults; override here if needed
EMBED_MODEL_GEMINI=gemini-embedding-001

# ASR (Groq Whisper)
ASR_MODEL=whisper-large-v3
ASR_MODEL_FAST=whisper-large-v3-turbo

# --- Voice platform (optional: only for the Vapi phone/web channel) ---
VAPI_API_KEY=
# Public HTTPS URL of this server (e.g. from `cloudflared tunnel --url http://localhost:8000`)
PUBLIC_BASE_URL=

# --- Business actions ---
# Optional: POST escalations here (e.g. a https://webhook.site URL). Always logged locally too.
ESCALATION_WEBHOOK_URL=

# Timezone used for due dates, callback windows and "today"
APP_TIMEZONE=Asia/Kolkata
