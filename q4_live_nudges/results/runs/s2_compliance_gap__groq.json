   "end_t": 5.78,
   "asr_ms": 337,
   "asr_conf": 0.919,
   "forced_cut": false,
   "audio_to_text_ms": 842
  },
  {
   "uid": 3,
   "speaker": "agent",
   "text": "I'm calling from Udaan.",
   "start_t": 6.44,
   "end_t": 7.8,
   "asr_ms": 217,
   "asr_conf": 0.818,
   "forced_cut": false,
   "audio_to_text_ms": 717
  },
  {
   "uid": 4,
   "speaker": "agent",
   "text": "Your business loan EMI of 42,000 rupees is due on the 5th and you need",
   "start_t": 8.7,
   "end_t": 14.74,
   "asr_ms": 372,
   "asr_conf": 0.914,
   "forced_cut": true,
   "audio_to_text_ms": 375
  },
  {
   "uid": 5,
   "speaker": "agent",
   "text": "to pay it on time.",
   "start_t": 14.82,
   "end_t": 16.0,
   "asr_ms": 222,
   "asr_conf": 0.722,
   "forced_cut": false,
   "audio_to_text_ms": 719
  },
  {
   "uid": 6,
   "speaker": "customer",
   "text": "Okay, but I may be a few days late this time, my client payment is stuck.",
   "start_t": 16.66,
   "end_t": 21.5,
   "asr_ms": 530,
   "asr_conf": 0.893,
   "forced_cut": false,
   "audio_to_text_ms": 1033
  },
  {
   "uid": 7,
   "speaker": "agent",
   "text": "Sir, if you don't pay by the fifth,",
   "start_t": 22.32,
   "end_t": 24.66,
   "asr_ms": 295,
   "asr_conf": 0.82,
   "forced_cut": false,
   "audio_to_text_ms": 796
  },
  {
   "uid": 8,
   "speaker": "agent",
   "text": "Our recovery team will come to your office and we will take legal action.",
   "start_t": 25.14,
   "end_t": 29.72,
   "asr_ms": 308,
   "asr_conf": 0.946,
   "forced_cut": false,
   "audio_to_text_ms": 809
  },
  {
   "uid": 9,
   "speaker": "customer",
   "text": "What?",
   "start_t": 30.24,
   "end_t": 30.78,
   "asr_ms": 214,
   "asr_conf": 0.773,
   "forced_cut": false,
   "audio_to_text_ms": 716
  },
  {
   "uid": 10,
   "speaker": "customer",
   "text": "That's not fair.",
   "start_t": 31.64,
   "end_t": 32.72,
   "asr_ms": 220,
   "asr_conf": 0.812,
   "forced_cut": false,
   "audio_to_text_ms": 718
  },
  {
   "uid": 11,
   "speaker": "customer",
   "text": "I have always paid on time.",
   "start_t": 33.62,
   "end_t": 35.22,
   "asr_ms": 284,
   "asr_conf": 0.871,
   "forced_cut": false,
   "audio_to_text_ms": 788
  },
  {
   "uid": 12,
   "speaker": "agent",
   "text": "Don't worry sir, I can waive the late fee for you this time, just pay by the 10th.",
   "start_t": 36.06,
   "end_t": 41.66,
   "asr_ms": 317,
   "asr_conf": 0.915,
   "forced_cut": true,
   "audio_to_text_ms": 725
  },
  {
   "uid": 13,
