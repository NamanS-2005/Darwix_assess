   "end_t": 25.96,
   "asr_ms": 384,
   "asr_conf": 0.956,
   "forced_cut": false,
   "audio_to_text_ms": 886
  },
  {
   "uid": 13,
   "speaker": "customer",
   "text": "8-8-1-0.",
   "start_t": 26.54,
   "end_t": 27.8,
   "asr_ms": 263,
   "asr_conf": 0.693,
   "forced_cut": false,
   "audio_to_text_ms": 765
  },
  {
   "uid": 14,
   "speaker": "agent",
   "text": "Phone call.",
   "start_t": 27.48,
   "end_t": 27.82,
   "asr_ms": 297,
   "asr_conf": 0.334,
   "forced_cut": false,
   "audio_to_text_ms": 798
  },
  {
   "uid": 15,
   "speaker": "agent",
   "text": "Thank you, sir.",
   "start_t": 28.52,
   "end_t": 29.3,
   "asr_ms": 221,
   "asr_conf": 0.889,
   "forced_cut": false,
   "audio_to_text_ms": 721
  },
  {
   "uid": 16,
   "speaker": "customer",
   "text": "Phone call.",
   "start_t": 31.04,
   "end_t": 31.42,
   "asr_ms": 220,
   "asr_conf": 0.337,
   "forced_cut": false,
   "audio_to_text_ms": 723
  },
  {
   "uid": 17,
   "speaker": "agent",
   "text": "Your personal loan EMI of 7,000 rupees is due on the 5th.",
   "start_t": 30.18,
   "end_t": 34.88,
   "asr_ms": 265,
   "asr_conf": 0.859,
   "forced_cut": false,
   "audio_to_text_ms": 770
  },
  {
   "uid": 18,
   "speaker": "agent",
   "text": "It will be debited automatically.",
   "start_t": 35.84,
   "end_t": 37.76,
   "asr_ms": 321,
   "asr_conf": 0.759,
   "forced_cut": false,
   "audio_to_text_ms": 821
  },
  {
   "uid": 19,
   "speaker": "customer",
   "text": "Yes.",
   "start_t": 38.32,
   "end_t": 38.62,
   "asr_ms": 221,
   "asr_conf": 0.678,
   "forced_cut": false,
   "audio_to_text_ms": 720
  },
  {
   "uid": 20,
   "speaker": "customer",
   "text": "Yes, it's fine.",
   "start_t": 39.1,
   "end_t": 40.26,
   "asr_ms": 231,
   "asr_conf": 0.868,
   "forced_cut": false,
   "audio_to_text_ms": 733
  },
  {
   "uid": 21,
   "speaker": "customer",
   "text": "My brother also took a bike loan last year.",
