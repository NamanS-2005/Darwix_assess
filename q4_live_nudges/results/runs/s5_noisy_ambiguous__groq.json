   "end_t": 43.86,
   "asr_ms": 491,
   "asr_conf": 0.943,
   "forced_cut": false,
   "audio_to_text_ms": 994
  },
  {
   "uid": 22,
   "speaker": "customer",
   "text": "He paid it off already, haha.",
