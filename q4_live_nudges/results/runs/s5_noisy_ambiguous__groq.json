   "asr_ms": 217,
   "asr_conf": 0.643,
   "forced_cut": false,
   "audio_to_text_ms": 717
  },
  {
   "uid": 7,
   "speaker": "customer",
   "text": "Yes.",
   "start_t": 13.82,
   "end_t": 14.0,
   "asr_ms": 216,
   "asr_conf": 0.689,
   "forced_cut": false,
   "audio_to_text_ms": 717
  },
  {
   "uid": 8,
   "speaker": "agent",
   "text": "Phone call.",
   "start_t": 14.46,
   "end_t": 14.82,
   "asr_ms": 227,
   "asr_conf": 0.324,
   "forced_cut": false,
   "audio_to_text_ms": 740
  },
  {
   "uid": 9,
   "speaker": "customer",
   "text": "Sorry, it's a bit noisy here.",
   "start_t": 15.32,
   "end_t": 17.24,
   "asr_ms": 281,
   "asr_conf": 0.897,
   "forced_cut": false,
   "audio_to_text_ms": 786
  },
  {
   "uid": 10,
   "speaker": "customer",
   "text": "I'm at the market.",
   "start_t": 17.72,
   "end_t": 18.32,
   "asr_ms": 330,
   "asr_conf": 0.926,
   "forced_cut": false,
   "audio_to_text_ms": 831
  },
  {
   "uid": 11,
   "speaker": "agent",
   "text": "No problem, sir.",
   "start_t": 19.32,
   "end_t": 20.38,
   "asr_ms": 377,
   "asr_conf": 0.758,
   "forced_cut": false,
   "audio_to_text_ms": 874
  },
  {
   "uid": 12,
   "speaker": "agent",
   "text": "For verification, could you tell me the last four digits of your loan account?",
