 "transcript": [
  {
   "uid": 1,
   "speaker": "agent",
   "text": "Good morning, this is Karan from Udaan Credit Finance.",
   "start_t": 0.5,
   "end_t": 4.12,
   "asr_ms": 1562,
   "asr_conf": 0.841,
   "forced_cut": false,
   "audio_to_text_ms": 2074
  },
  {
   "uid": 2,
   "speaker": "agent",
   "text": "This call is recorded for quality and compliance.",
   "start_t": 4.9,
   "end_t": 8.14,
   "asr_ms": 243,
   "asr_conf": 0.872,
   "forced_cut": false,
   "audio_to_text_ms": 743
  },
  {
   "uid": 3,
   "speaker": "agent",
   "text": "Am I speaking with Ms. Priya Menon?",
   "start_t": 9.18,
   "end_t": 11.46,
   "asr_ms": 261,
   "asr_conf": 0.795,
   "forced_cut": false,
   "audio_to_text_ms": 760
  },
  {
   "uid": 4,
   "speaker": "customer",
   "text": "Yes, this is Priya speaking.",
   "start_t": 11.94,
   "end_t": 14.0,
   "asr_ms": 224,
   "asr_conf": 0.861,
   "forced_cut": false,
   "audio_to_text_ms": 724
  },
  {
   "uid": 5,
   "speaker": "agent",
   "text": "Thank you.",
   "start_t": 14.74,
   "end_t": 15.3,
   "asr_ms": 354,
   "asr_conf": 0.799,
   "forced_cut": false,
   "audio_to_text_ms": 850
  },
  {
   "uid": 6,
   "speaker": "agent",
   "text": "For verification, could you please tell me your date of birth?",
   "start_t": 16.22,
   "end_t": 19.66,
   "asr_ms": 256,
   "asr_conf": 0.9,
   "forced_cut": false,
   "audio_to_text_ms": 772
  },
  {
   "uid": 7,
   "speaker": "customer",
   "text": "Sure, it's the 9th of March, 1989.",
   "start_t": 20.34,
   "end_t": 23.86,
   "asr_ms": 242,
   "asr_conf": 0.846,
   "forced_cut": false,
   "audio_to_text_ms": 757
  },
  {
   "uid": 8,
   "speaker": "agent",
   "text": "Thank you for confirming.",
   "start_t": 24.5,
   "end_t": 25.88,
   "asr_ms": 227,
   "asr_conf": 0.893,
   "forced_cut": false,
   "audio_to_text_ms": 729
  },
  {
   "uid": 9,
   "speaker": "agent",
   "text": "I'm calling to remind you that your personal loan EMI of 9,200 rupees is",
   "start_t": 26.8,
   "end_t": 32.84,
   "asr_ms": 345,
   "asr_conf": 0.882,
   "forced_cut": true,
   "audio_to_text_ms": 348
  },
  {
   "uid": 10,
   "speaker": "agent",
   "text": "It's due on the 5th.",
   "start_t": 32.88,
   "end_t": 33.72,
   "asr_ms": 407,
   "asr_conf": 0.712,
   "forced_cut": false,
   "audio_to_text_ms": 907
  },
  {
   "uid": 11,
   "speaker": "customer",
   "text": "Okay.",
   "start_t": 34.44,
   "end_t": 34.92,
   "asr_ms": 220,
   "asr_conf": 0.626,
   "forced_cut": false,
   "audio_to_text_ms": 718
  },
  {
   "uid": 12,
   "speaker": "customer",
   "text": "Actually, this month is a bit heavy for me.",
   "start_t": 35.88,
   "end_t": 38.36,
   "asr_ms": 217,
   "asr_conf": 0.882,
   "forced_cut": false,
   "audio_to_text_ms": 732
  },
  {
   "uid": 13,
   "speaker": "customer",
   "text": "My daughter just got admission in an engineering college and I have to arrange her fees next month.",
   "start_t": 39.38,
   "end_t": 44.98,
   "asr_ms": 386,
   "asr_conf": 0.927,
   "forced_cut": true,
   "audio_to_text_ms": 791
  },
  {
   "uid": 14,
   "speaker": "agent",
   "text": "I understand.",
   "start_t": 45.78,
   "end_t": 46.68,
   "asr_ms": 230,
   "asr_conf": 0.758,
   "forced_cut": false,
   "audio_to_text_ms": 735
  },
  {
   "uid": 15,
   "speaker": "agent",
   "text": "Will the EMI be paid through auto-debit as usual?",
   "start_t": 47.64,
   "end_t": 50.8,
   "asr_ms": 239,
   "asr_conf": 0.87,
   "forced_cut": false,
   "audio_to_text_ms": 742
  },
  {
   "uid": 16,
   "speaker": "customer",
   "text": "Yes, the auto-debit is fine.",
   "start_t": 51.34,
   "end_t": 53.5,
   "asr_ms": 226,
   "asr_conf": 0.841,
   "forced_cut": false,
   "audio_to_text_ms": 726
  },
  {
   "uid": 17,
   "speaker": "customer",
   "text": "Also my son wants a scooter for college,",
   "start_t": 54.42,
   "end_t": 56.8,
   "asr_ms": 226,
   "asr_conf": 0.965,
   "forced_cut": false,
   "audio_to_text_ms": 726
  },
  {
   "uid": 18,
   "speaker": "customer",
   "text": "So we are thinking of buying a second two-wheeler soon.",
   "start_t": 57.28,
   "end_t": 59.94,
   "asr_ms": 227,
   "asr_conf": 0.921,
   "forced_cut": false,
   "audio_to_text_ms": 730
  },
  {
   "uid": 19,
   "speaker": "agent",
   "text": "Okay, man.",
   "start_t": 60.74,
   "end_t": 61.4,
   "asr_ms": 230,
   "asr_conf": 0.75,
   "forced_cut": false,
   "audio_to_text_ms": 730
  },
  {
   "uid": 20,
   "speaker": "agent",
   "text": "Please keep sufficient balance in your account one day before the due date.",
   "start_t": 62.38,
   "end_t": 67.04,
   "asr_ms": 325,
   "asr_conf": 0.916,
   "forced_cut": false,
   "audio_to_text_ms": 824
  },
  {
   "uid": 21,
   "speaker": "customer",
   "text": "Sure, I will do that.",
   "start_t": 67.76,
   "end_t": 69.4,
   "asr_ms": 218,
   "asr_conf": 0.817,
   "forced_cut": false,
   "audio_to_text_ms": 719
  },
  {
   "uid": 22,
   "speaker": "agent",
   "text": "Thank you for your time. Have a nice day.",
   "start_t": 70.18,
   "end_t": 72.9,
   "asr_ms": 233,
   "asr_conf": 0.914,
   "forced_cut": false,
   "audio_to_text_ms": 734
  }
 ],
