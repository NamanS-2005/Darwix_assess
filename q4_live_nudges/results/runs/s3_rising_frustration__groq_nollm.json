   "asr_ms": 213,
   "asr_conf": 0.567,
   "forced_cut": false,
   "audio_to_text_ms": 703
  },
  {
   "uid": 4,
   "speaker": "agent",
   "text": "Thank you.",
   "start_t": 10.32,
   "end_t": 10.98,
   "asr_ms": 219,
   "asr_conf": 0.787,
   "forced_cut": false,
   "audio_to_text_ms": 718
  },
  {
