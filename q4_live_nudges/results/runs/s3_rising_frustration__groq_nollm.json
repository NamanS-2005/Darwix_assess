   "speaker": "agent",
   "text": "Could you confirm the last four digits of your loan account for verification?",
   "start_t": 11.88,
   "end_t": 15.9,
   "asr_ms": 268,
   "asr_conf": 0.833,
   "forced_cut": false,
   "audio_to_text_ms": 769
  },
  {
   "uid": 6,
   "speaker": "customer",
   "text": "4421.",
