   "end_t": 17.5,
   "asr_ms": 238,
   "asr_conf": 0.588,
   "forced_cut": false,
   "audio_to_text_ms": 736
  },
  {
   "uid": 7,
   "speaker": "agent",
   "text": "Thank you.",
   "start_t": 18.28,
   "end_t": 18.94,
   "asr_ms": 539,
   "asr_conf": 0.772,
   "forced_cut": false,
   "audio_to_text_ms": 1038
  },
  {
   "uid": 8,
   "speaker": "agent",
   "text": "Your two-wheeler loan EMI of Rs.3,100 is due on the 5th.",
   "start_t": 19.84,
   "end_t": 24.38,
   "asr_ms": 437,
   "asr_conf": 0.858,
   "forced_cut": false,
   "audio_to_text_ms": 950
  },
  {
   "uid": 9,
   "speaker": "agent",
   "text": "How would you like to pay?",
   "start_t": 25.44,
   "end_t": 26.7,
   "asr_ms": 378,
   "asr_conf": 0.851,
   "forced_cut": false,
   "audio_to_text_ms": 882
  },
  {
   "uid": 10,
   "speaker": "customer",
   "text": "I already paid it two days ago through UPI.",
   "start_t": 27.18,
   "end_t": 30.06,
   "asr_ms": 493,
   "asr_conf": 0.891,
   "forced_cut": false,
   "audio_to_text_ms": 996
  },
  {
   "uid": 11,
   "speaker": "customer",
   "text": "Why are you calling me?",
   "start_t": 30.88,
   "end_t": 32.16,
   "asr_ms": 460,
   "asr_conf": 0.799,
   "forced_cut": false,
   "audio_to_text_ms": 960
  },
  {
   "uid": 12,
   "speaker": "agent",
   "text": "Sir, our system shows it is still pending.",
   "start_t": 32.86,
   "end_t": 35.68,
   "asr_ms": 403,
   "asr_conf": 0.882,
   "forced_cut": false,
   "audio_to_text_ms": 908
  },
  {
   "uid": 13,
   "speaker": "agent",
   "text": "Please make the payment today.",
   "start_t": 36.52,
   "end_t": 38.02,
   "asr_ms": 249,
   "asr_conf": 0.758,
   "forced_cut": false,
   "audio_to_text_ms": 754
  },
  {
   "uid": 14,
   "speaker": "customer",
   "text": "This is the third time someone from your company has called me this week.",
   "start_t": 38.54,
   "end_t": 42.82,
   "asr_ms": 325,
   "asr_conf": 0.918,
   "forced_cut": false,
   "audio_to_text_ms": 824
  },
  {
   "uid": 15,
   "speaker": "customer",
   "text": "I told you I have already paid.",
   "start_t": 43.66,
   "end_t": 45.64,
   "asr_ms": 257,
   "asr_conf": 0.827,
   "forced_cut": false,
   "audio_to_text_ms": 753
  },
  {
   "uid": 16,
   "speaker": "agent",
   "text": "Sir, the payment is not reflecting, so you need to pay to avoid charges.",
   "start_t": 46.44,
   "end_t": 51.46,
   "asr_ms": 657,
   "asr_conf": 0.9,
   "forced_cut": false,
   "audio_to_text_ms": 1160
  },
  {
   "uid": 17,
   "speaker": "customer",
   "text": "This is ridiculous.",
   "start_t": 51.92,
   "end_t": 53.14,
   "asr_ms": 266,
   "asr_conf": 0.754,
   "forced_cut": false,
   "audio_to_text_ms": 769
  },
  {
   "uid": 18,
   "speaker": "customer",
   "text": "I am not paying twice.",
   "start_t": 53.88,
   "end_t": 55.16,
   "asr_ms": 235,
   "asr_conf": 0.844,
   "forced_cut": false,
   "audio_to_text_ms": 735
  },
  {
   "uid": 19,
   "speaker": "customer",
   "text": "I am fed up with these calls, stop calling me.",
   "start_t": 56.1,
   "end_t": 59.02,
   "asr_ms": 232,
   "asr_conf": 0.884,
   "forced_cut": false,
   "audio_to_text_ms": 734
  },
  {
