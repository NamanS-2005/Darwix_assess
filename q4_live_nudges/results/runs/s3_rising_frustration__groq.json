 "transcript": [
  {
   "uid": 1,
   "speaker": "agent",
   "text": "Good afternoon. This is Nia from Udaan Credit Finance. This call is recorded.",
   "start_t": 0.5,
   "end_t": 5.52,
   "asr_ms": 338,
   "asr_conf": 0.908,
   "forced_cut": false,
   "audio_to_text_ms": 838
  },
  {
   "uid": 2,
   "speaker": "agent",
   "text": "Am I speaking with Mr. Imran Khan?",
   "start_t": 6.42,
   "end_t": 8.66,
   "asr_ms": 228,
   "asr_conf": 0.864,
   "forced_cut": false,
   "audio_to_text_ms": 726
  },
  {
   "uid": 3,
   "speaker": "customer",
   "text": "Yes.",
   "start_t": 9.18,
   "end_t": 9.48,
   "asr_ms": 232,
   "asr_conf": 0.567,
   "forced_cut": false,
   "audio_to_text_ms": 736
  },
  {
   "uid": 4,
   "speaker": "agent",
   "text": "Thank you.",
   "start_t": 10.32,
   "end_t": 10.98,
   "asr_ms": 406,
   "asr_conf": 0.787,
   "forced_cut": false,
   "audio_to_text_ms": 906
  },
  {
   "uid": 5,
   "speaker": "agent",
   "text": "Could you confirm the last four digits of your loan account for verification?",
   "start_t": 11.88,
   "end_t": 15.9,
   "asr_ms": 228,
   "asr_conf": 0.833,
   "forced_cut": false,
   "audio_to_text_ms": 730
  },
  {
   "uid": 6,
   "speaker": "customer",
   "text": "4421.",
   "start_t": 16.48,
   "end_t": 17.5,
   "asr_ms": 218,
   "asr_conf": 0.588,
   "forced_cut": false,
   "audio_to_text_ms": 706
  },
  {
   "uid": 7,
   "speaker": "agent",
   "text": "Thank you.",
   "start_t": 18.28,
   "end_t": 18.94,
   "asr_ms": 222,
   "asr_conf": 0.772,
   "forced_cut": false,
   "audio_to_text_ms": 724
  },
  {
   "uid": 8,
   "speaker": "agent",
   "text": "Your two-wheeler loan EMI of Rs.3,100 is due on the 5th.",
   "start_t": 19.84,
   "end_t": 24.38,
   "asr_ms": 322,
   "asr_conf": 0.858,
   "forced_cut": false,
   "audio_to_text_ms": 838
  },
  {
   "uid": 9,
   "speaker": "agent",
   "text": "How would you like to pay?",
   "start_t": 25.44,
   "end_t": 26.7,
   "asr_ms": 221,
   "asr_conf": 0.851,
   "forced_cut": false,
   "audio_to_text_ms": 720
  },
  {
   "uid": 10,
   "speaker": "customer",
   "text": "I already paid it two days ago through UPI.",
   "start_t": 27.18,
   "end_t": 30.06,
   "asr_ms": 230,
   "asr_conf": 0.891,
   "forced_cut": false,
   "audio_to_text_ms": 726
  },
  {
   "uid": 11,
   "speaker": "customer",
   "text": "Why are you calling me?",
   "start_t": 30.88,
   "end_t": 32.16,
   "asr_ms": 241,
   "asr_conf": 0.799,
   "forced_cut": false,
   "audio_to_text_ms": 754
  },
  {
   "uid": 12,
   "speaker": "agent",
   "text": "Sir, our system shows it is still pending.",
   "start_t": 32.86,
   "end_t": 35.68,
   "asr_ms": 225,
   "asr_conf": 0.882,
   "forced_cut": false,
   "audio_to_text_ms": 726
  },
  {
   "uid": 13,
   "speaker": "agent",
   "text": "Please make the payment today.",
   "start_t": 36.52,
   "end_t": 38.02,
   "asr_ms": 362,
   "asr_conf": 0.758,
   "forced_cut": false,
   "audio_to_text_ms": 860
  },
  {
   "uid": 14,
   "speaker": "customer",
   "text": "This is the third time someone from your company has called me this week.",
   "start_t": 38.54,
   "end_t": 42.82,
   "asr_ms": 233,
   "asr_conf": 0.918,
   "forced_cut": false,
   "audio_to_text_ms": 747
  },
  {
   "uid": 15,
   "speaker": "customer",
   "text": "I told you I have already paid.",
   "start_t": 43.66,
   "end_t": 45.64,
   "asr_ms": 241,
   "asr_conf": 0.827,
   "forced_cut": false,
   "audio_to_text_ms": 744
  },
  {
   "uid": 16,
   "speaker": "agent",
   "text": "Sir, the payment is not reflecting, so you need to pay to avoid charges.",
   "start_t": 46.44,
   "end_t": 51.46,
   "asr_ms": 312,
   "asr_conf": 0.9,
   "forced_cut": false,
   "audio_to_text_ms": 811
  },
  {
   "uid": 17,
   "speaker": "customer",
   "text": "This is ridiculous.",
   "start_t": 51.92,
   "end_t": 53.14,
   "asr_ms": 279,
   "asr_conf": 0.754,
   "forced_cut": false,
   "audio_to_text_ms": 782
  },
  {
   "uid": 18,
   "speaker": "customer",
   "text": "I am not paying twice.",
   "start_t": 53.88,
   "end_t": 55.16,
   "asr_ms": 222,
   "asr_conf": 0.844,
   "forced_cut": false,
   "audio_to_text_ms": 724
  },
  {
   "uid": 19,
   "speaker": "customer",
   "text": "I am fed up with these calls, stop calling me.",
   "start_t": 56.1,
   "end_t": 59.02,
   "asr_ms": 316,
   "asr_conf": 0.884,
   "forced_cut": false,
   "audio_to_text_ms": 815
  },
  {
   "uid": 20,
   "speaker": "agent",
   "text": "Sir, please calm down.",
   "start_t": 59.74,
   "end_t": 61.44,
   "asr_ms": 242,
   "asr_conf": 0.673,
   "forced_cut": false,
   "audio_to_text_ms": 743
  },
  {
   "uid": 21,
   "speaker": "customer",
   "text": "Don't tell me to calm down.",
   "start_t": 61.9,
   "end_t": 63.48,
   "asr_ms": 228,
   "asr_conf": 0.81,
   "forced_cut": false,
   "audio_to_text_ms": 732
  },
